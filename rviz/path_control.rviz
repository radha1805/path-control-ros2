Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Smooth Path
      Topic:
        Value: /smooth_path
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Waypoints
      Topic:
        Value: /waypoints_viz
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Trajectory Arrows
      Topic:
        Value: /trajectory_viz
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot
      Topic:
        Value: /robot_marker
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot Trace
      Topic:
        Value: /robot_trace
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 100
      X: 3.5
      Y: 2.0
